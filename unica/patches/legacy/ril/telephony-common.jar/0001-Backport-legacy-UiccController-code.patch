     invoke-virtual {p1}, Ljava/lang/String;->length()I
 
     move-result v0
@@ -2286,7 +2343,7 @@
 
     goto :goto_1
 
-    :cond_2
+    :cond_ril_legacy_3
     return v1
 
     :cond_3
@@ -7635,7 +7692,7 @@
 
     invoke-virtual {v2, v3}, Lcom/android/internal/telephony/uicc/UiccSlot;->onRadioStateUnavailable(I)V
 
