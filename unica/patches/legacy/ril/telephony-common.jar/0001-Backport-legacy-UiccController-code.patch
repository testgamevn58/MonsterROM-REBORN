+
+    array-length p2, v4
+
+    :cond_ril_legacy_unica_legacy_0
     new-instance v5, Ljava/lang/StringBuilder;
 
     invoke-direct {v5}, Ljava/lang/StringBuilder;-><init>()V
@@ -1057,7 +1114,7 @@
 
     goto :goto_0
 
