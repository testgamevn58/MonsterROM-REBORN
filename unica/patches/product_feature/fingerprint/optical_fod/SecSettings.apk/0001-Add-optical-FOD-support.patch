From 9675fb03d32168bfe9625b6dd01c1066569cc471 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Mon, 8 Sep 2025 22:25:57 +0200
Subject: [PATCH] Add optical FOD support

---
 .../BiometricsDisclaimerActivity.smali        |   2 +-
 .../SuwBiometricsDisclaimerActivity.smali     |   2 +-
 .../fingerprint/FingerprintSettings.smali     | 577 ++++++++++--------
 .../fingerprint/RegisterFingerprint.smali     | 330 +++++++---
 4 files changed, 577 insertions(+), 334 deletions(-)

diff --git a/smali_classes5/com/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint.smali b/smali_classes5/com/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint.smali
--- a/smali_classes5/com/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint.smali
+++ b/smali_classes5/com/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint.smali
@@ -29,6 +29,8 @@
 .field public mIsReCreatedRegistration:Z
 
 .field public mIsRunRegister:Z
+
+.field public mIsShowSurfaceUpdates:Z
 
 .field public mLockPatternUtils:Lcom/android/internal/widget/LockPatternUtils;
 
@@ -614,13 +616,13 @@
 
     iget-object v2, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mPreviousStage:Ljava/lang/String;
 
-    if-nez v2, :cond_4
+    if-nez v2, :cond_a
 
     const-string v2, "fingerprint_register_external"
 
     iput-object v2, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mPreviousStage:Ljava/lang/String;
 
-    :cond_4
+    :cond_a
     const-string v2, "android.intent.extra.USER_ID"
 
     invoke-static {}, Landroid/os/UserHandle;->myUserId()I
@@ -653,11 +655,11 @@
 
     const-string v3, "hw_auth_token"
 
-    const-string v5, "gk_pw_handle"
+    const-string v4, "gk_pw_handle"
 
     const-wide/16 v6, 0x0
 
-    if-eqz p1, :cond_5
+    if-eqz p1, :cond_b
 
     iget v8, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
 
@@ -665,7 +667,7 @@
 
     move-result v8
 
-    if-eqz v8, :cond_5
+    if-eqz v8, :cond_b
 
     const/4 v8, 0x0
 
@@ -700,17 +702,17 @@
 
     iput-wide v8, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mChallenge:J
 
-    :cond_6
-    :goto_0
+    :cond_c
+    :goto_5
     iget v8, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
 
     invoke-static {v8}, Lcom/samsung/android/app/SemDualAppManager;->isDualAppId(I)Z
 
     move-result v8
 
-    if-eqz v8, :cond_7
-
-    iput v4, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
+    if-eqz v8, :cond_d
+
+    iput v5, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
 
     new-instance v8, Ljava/lang/StringBuilder;
 
@@ -970,7 +972,7 @@
 
     move-result p1
 
-    if-eqz p1, :cond_11
+    if-eqz p1, :cond_17
 
     iget-object p1, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mLockPatternUtils:Lcom/android/internal/widget/LockPatternUtils;
 
@@ -980,20 +982,20 @@
 
     move-result p1
 
-    if-nez p1, :cond_12
+    if-nez p1, :cond_18
 
     iget p1, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
 
-    if-eqz p1, :cond_12
-
-    :cond_11
+    if-eqz p1, :cond_18
+
+    :cond_17
     iget p1, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mUserId:I
 
     invoke-static {p1}, Lcom/samsung/android/knox/SemPersonaManager;->isKnoxId(I)Z
 
     move-result p1
 
-    if-eqz p1, :cond_13
+    if-eqz p1, :cond_19
 
     iget-object p1, p0, Lcom/samsung/android/settings/biometrics/fingerprint/RegisterFingerprint;->mLockPatternUtils:Lcom/android/internal/widget/LockPatternUtils;
 
diff --git a/smali/com/android/settings/biometrics/fingerprint/FingerprintSettings.smali b/smali/com/android/settings/biometrics/fingerprint/FingerprintSettings.smali
--- a/smali/com/android/settings/biometrics/fingerprint/FingerprintSettings.smali
+++ b/smali/com/android/settings/biometrics/fingerprint/FingerprintSettings.smali
@@ -174,3 +174,5 @@
 
     return-void
 .end method
+    iput-object v1, p0, Lcom/samsung/android/settings/biometrics/fingerprint/FingerprintSettings;->mMaskViewToken:Landroid/os/IBinder;
